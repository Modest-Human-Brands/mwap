{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NuxTemplate",
  "version": "../package.json",
  "identifier": "dev.shirsendu-bairagi.nuxtemplate",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "dotenvx run -f .env.native -- nuxt dev",
    "beforeBuildCommand": "dotenvx run -f .env.native -- nuxt generate"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": true,
        "url": "/",
        "title": "NuxTemplate",
        "width": 1400,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyQTc5NUNGMkFBQUZBM0UKUldRKytxb3F6NVduOHZ2TEgwOGYrV3FQemVEN3d2RW9rNjM5N2tzeTJwMEhYRHZOVXl4S2Fyb00K",
      "endpoints": [
        "https://github.com/shba007/nuxtemplate/releases/latest/download/latest.json"
      ]
    }
  }
}